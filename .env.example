# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave unset for local dev — the app falls back to an embedded PGlite DB at
# ./.data/local-db (created automatically). Point this at a Neon or Supabase
# Postgres connection string for anything shared/deployed.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Auth (Clerk) — https://dashboard.clerk.com
# ---------------------------------------------------------------------------
# Leave both unset for local dev — middleware.ts skips Clerk entirely and
# lib/auth.ts returns a seeded mock admin user so every page renders without
# an account. Set both to turn on real multi-tenant auth.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# File / audio storage (Supabase Storage or any S3-compatible bucket)
# ---------------------------------------------------------------------------
# Only a signed URL is ever stored in Postgres — see lib/storage.ts.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=call-audio

# ---------------------------------------------------------------------------
# Speech-to-text (Deepgram)
# ---------------------------------------------------------------------------
# Leave unset to run the pipeline against a deterministic mock transcript —
# see lib/integrations/deepgram.ts.
# DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Translation (Google Cloud Translation API)
# ---------------------------------------------------------------------------
# Leave unset to pass the transcript through untranslated (mock) — see
# lib/integrations/translate.ts.
# GOOGLE_TRANSLATE_API_KEY=

# ---------------------------------------------------------------------------
# LLM scoring engine (Anthropic Claude)
# ---------------------------------------------------------------------------
# Leave unset to run the pipeline against a deterministic mock scorer — see
# lib/integrations/claude.ts. Real scoring needs this key.
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Background jobs (Inngest)
# ---------------------------------------------------------------------------
# Leave unset for local dev — functions still run (via `npx inngest-cli dev`
# or direct invocation), just without the hosted dashboard.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------
# CRM integration (Leadsquared)
# ---------------------------------------------------------------------------
# Per-org config also lives in organizations.leadsquared_config (Setup >
# Leadsquared) — these act as the default/fallback for local dev and scripts.
# LEADSQUARED_ACCESS_KEY=
# LEADSQUARED_SECRET_KEY=
# LEADSQUARED_HOST=https://api.leadsquared.com

# ---------------------------------------------------------------------------
# Email (Resend) — flagged-call alerts to QA managers
# ---------------------------------------------------------------------------
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Observability / analytics
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
